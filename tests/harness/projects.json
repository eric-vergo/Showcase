{
  "version": 2,
  "release_targets": [
    {
      "id": "v4.28.0",
      "toolchain": "v4.28.0",
      "verso_ref": "v4.28.0",
      "branch": "v4.28.0",
      "deploy_pages": true
    },
    {
      "id": "v4.29.0",
      "toolchain": "v4.29.0",
