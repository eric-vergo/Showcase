{
  "version": 2,
  "release_targets": [
    {
      "id": "v4.28.0",
      "toolchain": "v4.28.0",
      "verso_ref": "v4.28.0",
      "branch": "v4.28.0",
      "deploy_pages": false
    },
    {
      "id": "v4.29.0",
      "toolchain": "v4.29.0",
      "verso_ref": "v4.29.0",
      "branch": "v4.29.0",
      "deploy_pages": true
    }
  ],
  "projects": [
    {
      "id": "project-template",
      "description": "In-repo starter Blueprint template rendered as a small reference site.",
      "source": {
        "kind": "in_repo_example",
        "project_root": "project_template"
      },
      "targets": [
        {
          "release": "v4.28.0",
          "publish": true
        },
        {
          "release": "v4.29.0",
          "publish": true
        }
      ],
      "build_command": ["lake", "build"],
      "generate_command": ["lake", "exe", "blueprint-gen", "--output", "{output_dir}"],
      "site_subdir": "html-multi"
    },
    {
      "id": "noperthedron",
      "description": "Mathlib-heavy external blueprint example kept for generation coverage.",
      "source": {
        "kind": "git_checkout",
        "repository": "https://github.com/ejgallego/verso-noperthedron.git",
        "project_root": "."
      },
      "targets": [
        {
          "release": "v4.29.0",
          "ref": "47f28af5e6d3edf0de439b7de9c3f121e14e4707",
          "publish": true
        }
      ],
      "prepare_command": [
        "git",
        "submodule",
        "update",
        "--init",
        "--depth",
        "1",
        "Noperthedron"
      ],
      "build_command": ["lake", "build"],
      "generate_command": ["lake", "exe", "blueprint-gen", "--output", "{output_dir}"],
      "site_subdir": "html-multi"
    },
    {
      "id": "spherepackingblueprint",
      "description": "External blueprint example without project-specific browser regressions.",
      "source": {
        "kind": "git_checkout",
        "repository": "https://github.com/ejgallego/verso-sphere-packing.git",
        "project_root": "."
      },
      "targets": [
        {
          "release": "v4.28.0",
          "ref": "4346c148b91c3a0d1060a0413176e8290a3e0839",
          "publish": true
        }
      ],
      "prepare_command": [
        "git",
        "-c",
        "url.https://github.com/.insteadOf=git@github.com:",
        "-c",
        "url.https://github.com/.insteadOf=ssh://git@github.com/",
        "submodule",
        "update",
        "--init",
        "--depth",
        "1",
        "Sphere-Packing-LaTeX-Reference"
      ],
      "build_command": ["lake", "build"],
      "generate_command": ["lake", "exe", "blueprint-gen", "--output", "{output_dir}"],
      "site_subdir": "html-multi"
    },
    {
      "id": "verso-flt",
      "description": "External FLT blueprint integration layer with an FLT submodule checkout.",
      "source": {
        "kind": "git_checkout",
        "repository": "https://github.com/ejgallego/verso-flt.git",
        "project_root": "."
      },
      "targets": [
        {
          "release": "v4.28.0",
          "ref": "1d4f671ee5aa6169bd263384d52d97b8957d2d15",
          "publish": true
        }
      ],
      "prepare_command": [
        "git",
        "-c",
        "url.https://github.com/.insteadOf=git@github.com:",
        "-c",
        "url.https://github.com/.insteadOf=ssh://git@github.com/",
        "submodule",
        "update",
        "--init",
        "--depth",
        "1",
        "FLT"
      ],
      "build_command": ["lake", "build", "blueprint-gen"],
      "generate_command": ["lake", "exe", "blueprint-gen", "--output", "{output_dir}"],
      "site_subdir": "html-multi"
    },
    {
      "id": "algebraic-combinatorics",
      "description": "External algebraic combinatorics blueprint example currently maintained on the v4.28.0 line.",
      "source": {
        "kind": "git_checkout",
        "repository": "https://github.com/ejgallego/verso-algebraic-combinatorics.git",
        "project_root": "."
      },
      "targets": [
        {
          "release": "v4.28.0",
          "ref": "6506b992702a6e47a29d90d504f9e55eb65e13e9",
          "publish": true
        }
      ],
      "prepare_command": [
        "git",
        "submodule",
        "update",
        "--init",
        "--depth",
        "1",
        "algebraic-combinatorics"
      ],
      "build_command": ["lake", "build", "blueprint-gen"],
      "generate_command": ["lake", "exe", "blueprint-gen", "--output", "{output_dir}"],
      "site_subdir": "html-multi"
    }
  ]
}
