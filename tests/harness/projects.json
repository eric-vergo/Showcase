{
  "version": 2,
  "projects": [
    {
      "id": "project-template",
      "description": "In-repo starter Blueprint template rendered as a small reference site.",
      "source": {
        "kind": "in_repo_project",
        "project_root": "project_template"
      },
      "targets": [
        {
          "release": "v4.30.0"
        }
      ],
      "build_command": ["lake", "build", "ProjectTemplate"],
      "generate_command": ["lake", "env", "lean", "--run", "ProjectTemplateMain.lean", "--output", "{output_dir}"],
      "site_subdir": "html-multi"
    },
    {
      "id": "noperthedron",
      "description": "Mathlib-heavy external blueprint project kept for generation coverage.",
      "source": {
        "kind": "git_checkout",
        "repository": "https://github.com/ejgallego/verso-noperthedron.git",
        "project_root": "."
      },
      "targets": [
        {
          "release": "v4.30.0",
          "ref": "8cf6336d54b166c89b64b3a4f4ce7c5e16c130a9",
          "publish_reference": true
        }
      ],
      "build_command": ["lake", "build", "Contents"],
      "generate_command": ["lake", "env", "lean", "--run", "Main.lean", "--output", "{output_dir}"],
      "site_subdir": "html-multi"
    },
    {
      "id": "spherepackingblueprint",
      "description": "External blueprint project without project-specific browser regressions.",
      "source": {
        "kind": "git_checkout",
        "repository": "https://github.com/ejgallego/verso-sphere-packing.git",
        "project_root": "."
      },
      "targets": [
        {
          "release": "v4.30.0",
          "ref": "db862606ae3996818d8bd00cedf327c121ffe332",
          "publish_reference": true
        }
      ],
      "build_command": ["lake", "build", "+SpherePackingBlueprint.Contents"],
      "generate_command": ["lake", "env", "lean", "--run", "SpherePackingBlueprintMain.lean", "--output", "{output_dir}"],
      "site_subdir": "html-multi"
    },
    {
      "id": "verso-flt",
      "description": "External FLT blueprint integration layer with an FLT submodule checkout.",
      "source": {
        "kind": "git_checkout",
        "repository": "https://github.com/ejgallego/verso-flt.git",
        "project_root": "."
      },
      "targets": [
        {
          "release": "v4.30.0",
          "ref": "bdbf237e4b6b025d597172cedb638521d09af5c5",
          "publish_reference": true
        }
      ],
      "build_command": ["lake", "build", "FLTBlueprint"],
      "generate_command": ["lake", "env", "lean", "--run", "FLTBlueprintMain.lean", "--output", "{output_dir}"],
      "site_subdir": "html-multi"
    },
    {
      "id": "verso-carleson",
      "description": "External Carleson blueprint integration layer with a Carleson submodule checkout.",
      "source": {
        "kind": "git_checkout",
        "repository": "https://github.com/ejgallego/verso-carleson.git",
        "project_root": "."
      },
      "targets": [
        {
          "release": "v4.30.0",
          "ref": "c391f509d468c769b1a0a70555455105dce47bb0",
          "rc": "4.30-rc2",
          "publish_reference": true
        }
      ],
      "build_command": ["lake", "build", "CarlesonBlueprint"],
      "generate_command": ["lake", "env", "lean", "--run", "BlueprintMain.lean", "--output", "{output_dir}"],
      "site_subdir": "html-multi"
    }
  ]
}
